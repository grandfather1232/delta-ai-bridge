local P=game:GetService("Players")
local U=game:GetService("UserInputService")
local pl=P.LocalPlayer
local on=false

local g=Instance.new("ScreenGui",game:GetService("CoreGui"))
g.Name="AutoFarm"
local f=Instance.new("Frame",g)
f.Size=UDim2.fromOffset(150,100)
f.Position=UDim2.new(.5,-75,.4,0)
f.BackgroundColor3=Color3.fromRGB(35,35,45)

local b=Instance.new("TextButton",f)
b.Size=UDim2.new(1,0,0,25)
b.Text="MOVE PANEL"
local s=Instance.new("TextButton",f)
s.Position=UDim2.fromOffset(0,25)
s.Size=UDim2.new(1,0,0,35)
s.Text="START"
local x=Instance.new("TextButton",f)
x.Position=UDim2.fromOffset(0,60)
x.Size=UDim2.new(1,0,0,35)
x.Text="STOP"

local drag,start,pos
b.InputBegan:Connect(function(i)
 if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
  drag=true start=i.Position pos=f.Position
 end
end)
U.InputChanged:Connect(function(i)
 if drag and (i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement) then
  local d=i.Position-start
  f.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y)
 end
end)
U.InputEnded:Connect(function(i)
 if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
end)

local function nearest(r)
 local best,dist
 for _,n in ipairs(workspace:GetDescendants()) do
  if n:IsA("Model") and n~=pl.Character and not P:GetPlayerFromCharacter(n) then
   local h=n:FindFirstChildOfClass("Humanoid")
   local t=n:FindFirstChild("HumanoidRootPart")
   if h and t and h.Health>0 then
    local d=(r.Position-t.Position).Magnitude
    if not dist or d<dist then best,dist=n,d end
   end
  end
 end
 return best
end

s.MouseButton1Click:Connect(function()
 if on then return end
 on=true
 task.spawn(function()
  local v=game:GetService("VirtualInputManager")
  v:SendKeyEvent(true,Enum.KeyCode.Two,false,game)
  task.wait(.1)
  v:SendKeyEvent(false,Enum.KeyCode.Two,false,game)
  local target
  while on do
   local c=pl.Character
   local r=c and c:FindFirstChild("HumanoidRootPart")
   local h=target and target:FindFirstChildOfClass("Humanoid")
   if not target or not target.Parent or not h or h.Health<=0 then
    target=r and nearest(r)
   end
   local t=target and target:FindFirstChild("HumanoidRootPart")
   if r and t then
    r.CFrame=CFrame.lookAt(t.Position-Vector3.new(0,8,0),t.Position)
    r.AssemblyLinearVelocity=Vector3.zero
   end
   task.wait(.05)
  end
 end)
end)

x.MouseButton1Click:Connect(function()
 on=false
end)
